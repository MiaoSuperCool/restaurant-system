# .env.example
# ============================================
# Flask 项目环境变量配置模板
# 使用方法：cp .env.example .env
# 然后修改 .env 中的值为真实配置
# ============================================

# ============================================
# 1. Flask 基础配置
# ============================================

# 运行环境：development / production / testing
FLASK_ENV=development

# 应用密钥（用于加密 Session）
# 生成方法：openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# 应用名称（显示在页面标题）
APP_NAME=餐饮管理系统


# ============================================
# 2. 数据库配置
# ============================================

# MySQL 数据库连接
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
# 示例：mysql+pymysql://root:password@localhost:3306/employee_management
DATABASE_URL=mysql+pymysql://用户名:密码@主机:端口/restaurant_system


# ============================================
# 3. Redis 配置（缓存/Session存储）
# ============================================

# Redis 连接
# 格式：redis://[:密码@]主机:端口/数据库编号
# 无密码：redis://localhost:6379/0
# 有密码：redis://:your_password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0


# ============================================
# 4. 安全配置
# ============================================

# Session Cookie 是否只在 HTTPS 下传输
# 开发环境：false，生产环境：true
SESSION_COOKIE_SECURE=false

# 密码加密强度（数值越高越安全，但登录越慢）
# 推荐值：12-14
BCRYPT_ROUNDS=12

# 允许跨域访问 /api/* 的前端来源（逗号分隔）
# 开发时填 Vite dev server 地址；前后端同域部署时留空即可
FRONTEND_ORIGINS=http://localhost:5173


# ============================================
# 5. 日志配置
# ============================================

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志目录（默认 backend/logs，一般无需修改）
# LOG_DIR=/path/to/logs


# ============================================
# 6. 管理员初始账号（manage.py create-admin 使用）
# ============================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_USERNAME=admin


# ============================================
# 7. 其他配置
# ============================================

# 默认分页大小
DEFAULT_PAGE_SIZE=10